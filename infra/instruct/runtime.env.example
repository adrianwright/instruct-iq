# Nonsecret deployment mapping, NOT a ready-to-use shared .env.
# Required browser/API Entra settings must come from NEW instructional registrations.
AZURE_TENANT_ID=<approved-tenant-uuid>
AZURE_CLIENT_ID=<new-api-user-assigned-managed-identity-client-id>
API_AUDIENCE=<new-instructional-api-audience>
API_REQUIRED_SCOPE=access_as_user
CORS_ORIGINS=https://<new-static-web-host>
VITE_API_BASE_URL=https://<new-container-app-host>
VITE_ENTRA_TENANT_ID=<approved-tenant-uuid>
VITE_ENTRA_CLIENT_ID=<new-spa-registration-client-id>
VITE_API_SCOPE=<new-api-fully-qualified-scope>

# Operator-maintained synthetic grants use the validated Entra oid as principal.subject
# (legacy tokens without oid retain sub). These are not live school membership.
# Deliberately empty grant/approver lists: fail closed until explicitly configured.
INSTRUCT_CLASS_GRANTS_JSON=[]
INSTRUCT_APPROVER_IDS_JSON=[]
INSTRUCT_FABRIC_WORKSPACE_ID=<new-workspace-uuid>
INSTRUCT_FABRIC_SEMANTIC_MODEL_ID=<new-semantic-model-dataset-uuid>
INSTRUCT_SEARCH_ENDPOINT=https://<new-instructional-search>.search.windows.net
INSTRUCT_FOUNDRY_KB_NAME=<new-dedicated-knowledge-base>
INSTRUCT_FOUNDRY_KNOWLEDGE_SOURCE=<new-dedicated-search-index-source>
INSTRUCT_SEARCH_API_VERSION=2026-08-01-preview
INSTRUCT_REQUEST_TIMEOUT_SECONDS=30
INSTRUCT_PROVIDER_TIMEOUT_SECONDS=20

# Dedicated instructional Work IQ boundary; never reuse a legacy Work IQ app.
INSTRUCT_WORKIQ_TENANT_ID=<approved-tenant-uuid>
INSTRUCT_WORKIQ_API_CLIENT_ID=<new-instructional-api-client-id>
INSTRUCT_WORKIQ_OPERATOR_ID=<approved-synthetic-operator-object-id>
# Local provisioning only. Keep real values in ignored operator configuration.
INSTRUCT_WORKIQ_SUBSCRIPTION_ID=<explicit-subscription-uuid>
INSTRUCT_WORKIQ_IDENTITY_PRINCIPAL_ID=<new-api-managed-identity-principal-id>
INSTRUCT_WORKIQ_VAULT_NAME=<dedicated-key-vault-name>
INSTRUCT_WORKIQ_API_RESOURCE_ID=/subscriptions/<explicit-subscription-uuid>/resourceGroups/rg-instruct-iq/providers/Microsoft.App/containerApps/<dedicated-api-name>
INSTRUCT_WORKIQ_EXPECTED_IMAGE=<dedicated-registry>.azurecr.io/instruct-api:<approved-image-tag>

# MCP narrative is NOT factual authority; these optional mappings do not replace
# the required semantic-model executeQueries transport.
INSTRUCT_FABRIC_DATA_AGENT_ID=
INSTRUCT_FABRIC_TOOL_NAME=
INSTRUCT_FABRIC_QUESTION_ARGUMENT=
